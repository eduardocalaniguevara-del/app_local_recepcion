# =====================================================================
# PLANTILLA DE CONFIGURACIÓN POR LAPTOP (.env.example)
# Copia este archivo como .env en cada laptop (NUNCA subas .env a GitHub)
# =====================================================================
# ARQUITECTURA HOTELERA DE 3 NIVELES (Elige el ROL_NODO de esta PC):
#   1. NIVEL_1_INGENIERIA   -> Tu Laptop 1 (modifica código, corre 02_PRIV_correo_bcp, sin QR WSP ni motor 24/7)
#   2. NIVEL_2_MADRE_HOTEL  -> Laptop 2 Recepción 24/7 (ÚNICA donde se escanea el QR de WhatsApp y corre motor_24x7)
#   3. NIVEL_3_TERCIARIA    -> Laptop 3, 4, Gerencia o Socios (recibe todo de Supabase y envía WSP vía cola de L2 sin escanear QR)
ROL_NODO=NIVEL_1_INGENIERIA

# Identificador único de esta máquina para trazabilidad en Supabase
EQUIPO_ID=LAPTOP_1_ADMIN

# Puerto del servidor web del Hostal
PUERTO_WEB=8080

# Interruptores físicos (se activan solos si ROL_NODO=NIVEL_2_MADRE_HOTEL, o puedes forzarlos aquí)
ACTIVAR_MOTOR_24X7=false
TIENE_QR_WSP_FISICO=false

# Conexión Supabase (hostal-ovalo)
SUPABASE_URL=https://fmlfqupwscymosvwnnzx.supabase.co
SUPABASE_KEY=REEMPLAZAR_CON_TU_SUPABASE_ANON_KEY
HOSTAL_SYNC_TOKEN=REEMPLAZAR_CON_TU_TOKEN_SYNC

# Carpeta compartida de PDFs SUNAT (Syncthing)
RUTA_HOSTAL_SISTEMA=C:\Hostal_Sistema
