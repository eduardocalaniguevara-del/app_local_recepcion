# =====================================================================
# PLANTILLA DE CONFIGURACIÓN POR LAPTOP Y HOTEL (.env.example)
# Copia este archivo como .env en cada laptop (NUNCA subas .env a GitHub)
# =====================================================================
# ROLES DE LA ARQUITECTURA DE 3 NIVELES:
#   1. NIVEL_1_INGENIERIA   -> Tu Laptop 1 (Funciona de 2 formas: Editor de código Git + Terminal Terciaria que recibe todo de L2 vía Supabase. CERO WhatsApp y CERO Gmail personal vinculado).
#   2. NIVEL_2_MADRE_HOTEL  -> Laptop 2 Recepción 24/7 (Tiene TODO para trabajar: su propio correo hostal.ovalo@gmail.com que recibe copia de BCP, el único QR de WhatsApp de Recepción, emite SUNAT y envía por su WSP).
#   3. NIVEL_3_TERCIARIA    -> Laptop 3, 4, Gerencia o Socios (Solo recibe información desde Supabase sin vincular WhatsApp ni correo).
ROL_NODO=NIVEL_1_INGENIERIA
EQUIPO_ID=LAPTOP_1_ADMIN
PUERTO_WEB=8080

# Datos propios del Hotel (Escalabilidad Multi-Hotel: para otro hotel solo cambias estas 2 líneas en su L2)
NOMBRE_HOTEL=Hotel El Óvalo Mariátegui
CORREO_RECEPCION_HOTEL=hostal.ovalo@gmail.com

# Interruptores exclusivos de la Laptop Madre del Hotel (true SOLO en Laptop 2 Recepción)
ACTIVAR_MOTOR_24X7=false
TIENE_QR_WSP_FISICO=false

# Conexión Supabase (hostal-ovalo)
SUPABASE_URL=https://fmlfqupwscymosvwnnzx.supabase.co
SUPABASE_KEY=REEMPLAZAR_CON_TU_SUPABASE_ANON_KEY
HOSTAL_SYNC_TOKEN=REEMPLAZAR_CON_TU_TOKEN_SYNC

# Carpeta compartida de PDFs SUNAT (Syncthing)
RUTA_HOSTAL_SISTEMA=C:\Hostal_Sistema
