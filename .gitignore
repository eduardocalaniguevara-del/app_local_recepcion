# =====================================================================
# ADUANA DE SEGURIDAD (.gitignore) — C:\Ovalo_Sistema_v2
# Regla de Oro: 1 Canal = 1 Propósito.
# - 01_PRIV_* y 02_PRIV_*: Privados de la laptop donde se creen (NUNCA suben a Git)
# - 03_DB_*: Base SQLite local de cada laptop (Sincroniza por Supabase, NO por Git)
# - 04_GIT_*, 05_GIT_*, 06_GIT_*: Código oficial que viaja por GitHub a cualquier laptop
# =====================================================================

# 1. Carpetas Privadas Locales (JAMÁS suben a GitHub)
01_PRIV_borradores/
02_PRIV_correo_bcp/
borradores/
privado_l1/

# 2. Base de datos SQLite local (Datos vivos viajan por Supabase, NO por Git)
03_DB_sqlite_local/
data/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# 3. Variables de entorno por laptop (.env decide el rol de Laptop 1, 2, 3...)
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*secret*
*credenciales*
supabase_config.json

# 4. Archivos temporales de Python / Sistema
__pycache__/
*.py[cod]
*.log
.DS_Store
Thumbs.db
