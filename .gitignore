# =====================================================================
# ADUANA DE SEGURIDAD (.gitignore) — C:\Ovalo_Sistema_v2
# Regla de Oro: 1 Canal = 1 Propósito (5 Carpetas 01..05)
# - 01_PRIV_borradores/: Privada de tu Laptop 1 para trabajar con agentes (NUNCA sube a Git)
# - 02_DB_sqlite_local/: Base SQLite local de cada laptop (Sincroniza por Supabase, NO por Git)
# - 03_GIT_*, 04_GIT_*, 05_GIT_*: Código oficial que viaja por GitHub a cualquier laptop
# =====================================================================

# 1. Carpeta Privada de Borradores con Agentes (JAMÁS sube a GitHub)
01_PRIV_borradores/
borradores/

# 2. Base de datos SQLite local (Datos vivos viajan por Supabase, NO por Git)
02_DB_sqlite_local/
data/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# 3. Variables de entorno por laptop (.env decide el rol y correo del hotel)
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*secret*
*credenciales*
supabase_config.json

# 4. Archivos temporales de Python / Sistema
__pycache__/
*.py[cod]
*.log
.DS_Store
Thumbs.db
