# 1. Oficinas Privadas de Laptop 1 (JAMÁS suben a GitHub ni viajan a Laptop 2)
borradores/
privado_l1/

# 2. Base de datos SQLite local (Los datos vivos viajan por Supabase, NO por Git)
data/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# 3. Variables de entorno, llaves y credenciales
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*secret*
*credenciales*
supabase_config.json

# 4. Archivos temporales de Python / Sistema
__pycache__/
*.py[cod]
*.log
.DS_Store
Thumbs.db
