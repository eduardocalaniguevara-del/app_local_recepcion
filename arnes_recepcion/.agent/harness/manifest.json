          "source": "GEMINI.md:58"
        },
        {
          "id": "GR-06",
          "name": "Navegador Predeterminado Edge",
          "severity": "MANDATORY",
          "trigger": "Automatización / MCP Navegador",
          "action": "Usar siempre Microsoft Edge; Chrome únicamente bajo pedido explícito",
          "source": "GEMINI.md:59"
        },
        {
          "id": "GR-07",
          "name": "Mandato de Integridad Absoluta",
